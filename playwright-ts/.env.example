# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# Application
APP_URL=http://auslan-ds-canary-app.s3-website-ap-southeast-2.amazonaws.com/#/authenticate/logout

# Browser (set HEADLESS=false for headed local runs)
HEADLESS=true

# Test credentials (required)
TEST_EMAIL=
TEST_PASSWORD=

# Optional: password for accounts the signup specs create (defaults to TEST_PASSWORD)
SIGNUP_PASSWORD=
# Optional: mobile number used in signup/contact forms (defaults to 0400000000)
TEST_PHONE=

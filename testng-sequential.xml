<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright Test Suite - Sequential Execution" parallel="false" thread-count="1">
    
    <!-- TestNG Listener for better reporting -->
    <listeners>
        <listener class-name="utils.TestListener"/>
    </listeners>
    
    <!-- 
    Sequential Execution Configuration:
    - parallel="false"   : Tests run one after another
    - thread-count="1"   : Single thread execution
    
    Use this configuration for:
    - Debugging tests
    - Troubleshooting issues
    - Avoiding parallel execution conflicts
    -->
    
    <!-- All Tests - Sequential Execution -->
    <test name="All Tests - Sequential Execution">
        <classes>
            <!-- Login Tests -->
            <class name="tests.LoginTest"/>
            
            <!-- Booking Tests -->
            <class name="tests.NdisBookingTest"/>
            <class name="tests.DuplicateNdisBookingTest"/>
            <class name="tests.CancelBookingTest"/>
            <class name="tests.UpdateAppointmentDateTest"/>
            
            <!-- Signup Tests -->
            <class name="tests.SignupNdisClientTest"/>
            <class name="tests.SignupOrganisationTest"/>
            <class name="tests.SignupOver65ClientTest"/>
        </classes>
    </test>
    
</suite>

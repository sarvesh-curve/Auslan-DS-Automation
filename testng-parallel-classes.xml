<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright Test Suite - Parallel Classes" parallel="classes" thread-count="3">
    
    <!-- 
    Parallel Execution at CLASS level:
    - parallel="classes" : Runs all test classes in parallel
    - thread-count="3"   : Maximum 3 test classes running simultaneously
    - Best for: When you have multiple tests in one class
    -->
    
    <test name="All Tests - Parallel Classes">
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.NdisBookingTest"/>
            <class name="tests.DuplicateNdisBookingTest"/>
            <class name="tests.CancelBookingTest"/>
            <class name="tests.UpdateAppointmentDateTest"/>
            <class name="tests.SignupNdisClientTest"/>
            <class name="tests.SignupOrganisationTest"/>
            <class name="tests.SignupOver65ClientTest"/>
        </classes>
    </test>
    
</suite>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Test Suite" parallel="methods" thread-count="3">
    
    <listeners>
        <listener class-name="utils.TestListener"/>
    </listeners>
    
    <!-- Smoke Tests - Quick validation of critical functionality -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.NdisBookingTest"/>
            <class name="tests.SignupNdisClientTest"/>
        </classes>
    </test>
    
</suite>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright Test Suite - Parallel Execution" parallel="methods" thread-count="5">
    
    <!-- TestNG Listener for better reporting -->
    <listeners>
        <listener class-name="utils.TestListener"/>
    </listeners>
    
    <!-- 
    Parallel Execution Configuration:
    - parallel="methods" : Runs all @Test methods in parallel
    - thread-count="5"   : Maximum 5 threads running simultaneously
    
    Each test method gets its own browser instance via @BeforeMethod
    -->
    
    <!-- All Tests -->
    <test name="All Tests - Parallel Execution">
        <classes>
            <!-- Login Tests -->
            <class name="tests.LoginTest"/>
            
            <!-- Booking Tests -->
            <class name="tests.NdisBookingTest"/>
            <class name="tests.DuplicateNdisBookingTest"/>
            <class name="tests.CancelBookingTest"/>
            <class name="tests.UpdateAppointmentDateTest"/>
            <class name="tests.Over65BookingTest"/>
            <class name="tests.OrgRepresentativeTest"/>
            <class name="tests.RecurringBookingTest"/>
            <class name="tests.AssignInterpreterTest"/>
            
            <!-- Signup Tests -->
            <class name="tests.SignupNdisClientTest"/>
            <class name="tests.SignupOrganisationTest"/>
            <class name="tests.SignupOver65ClientTest"/>
        </classes>
    </test>
    
</suite>

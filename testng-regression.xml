<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Test Suite" parallel="methods" thread-count="5">
    
    <!-- TestNG Listener for better reporting -->
    <listeners>
        <listener class-name="utils.TestListener"/>
    </listeners>
    
    <!-- 
    Regression Test Suite Configuration:
    - Runs all tests marked with group "regression"
    - Parallel execution with 5 threads
    - Complete validation of all functionality
    -->
    
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        
        <classes>
            <!-- Login Tests (smoke + regression) -->
            <class name="tests.LoginTest"/>
            
            <!-- Booking Tests (smoke + regression) -->
            <class name="tests.NdisBookingTest"/>
            <class name="tests.DuplicateNdisBookingTest"/>
            <class name="tests.CancelBookingTest"/>
            <class name="tests.UpdateAppointmentDateTest"/>
            
            <!-- Signup Tests (regression only) -->
            <class name="tests.SignupNdisClientTest"/>
            <class name="tests.SignupOrganisationTest"/>
            <class name="tests.SignupOver65ClientTest"/>
        </classes>
    </test>
    
</suite>
